<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Hoje" (2x2). Os textos e as barras daqui são os de exemplo da prévia do seletor; em uso, WidgetHoje.java troca tudo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo">

    <LinearLayout
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Entrou hoje · 3 vendas"
            android:textColor="@color/w_suave"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/valor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="R$ 1.840"
            android:textColor="@color/w_forte"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/delta_alta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="▲ 12,4% vs. ontem"
            android:textColor="@color/w_ok"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/delta_queda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="▼ 3,0% vs. ontem"
            android:textColor="@color/w_perigo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/delta_neutro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="igual a ontem"
            android:textColor="@color/w_suave"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/barras"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_barras_exemplo"
            android:tint="@color/w_primaria" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/rodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/atualizado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Atualizado 11:42"
                android:textColor="@color/w_suave"
                android:textSize="9sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_atualizar" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/estado_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Abra o VortexSmart"
            android:textColor="@color/w_forte"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estado_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="para carregar os números"
            android:textColor="@color/w_suave"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>

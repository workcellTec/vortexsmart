<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Contas de hoje" (4x2, só Gestor): contas fixas que vencem hoje ou estão atrasadas. Textos de exemplo = prévia do seletor; em uso, WidgetContas.java troca tudo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo">
    <LinearLayout
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Contas de hoje"
                android:textColor="@color/w_texto"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="R$ 1.890"
                android:textColor="@color/w_forte"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/conta1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/conta1_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Aluguel da loja"
                android:textColor="@color/w_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/conta1_hoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_alerta"
                android:layout_marginStart="6dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="hoje"
                android:textColor="@color/w_alerta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conta1_atraso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_perigo"
                android:layout_marginStart="6dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="2 dias"
                android:textColor="@color/w_perigo"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conta1_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="R$ 1.200"
                android:textColor="@color/w_forte"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/conta2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/conta2_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Internet"
                android:textColor="@color/w_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/conta2_hoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_alerta"
                android:layout_marginStart="6dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:text="hoje"
                android:textColor="@color/w_alerta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conta2_atraso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_perigo"
                android:layout_marginStart="6dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="2 dias"
                android:textColor="@color/w_perigo"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conta2_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="R$ 189,90"
                android:textColor="@color/w_forte"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/conta3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/conta3_nome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Fornecedor de capas"
                android:textColor="@color/w_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/conta3_hoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_alerta"
                android:layout_marginStart="6dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="hoje"
                android:textColor="@color/w_alerta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conta3_atraso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_perigo"
                android:layout_marginStart="6dp"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="2 dias"
                android:textColor="@color/w_perigo"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/conta3_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="R$ 500"
                android:textColor="@color/w_forte"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/mais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="+ 2 contas"
            android:textColor="@color/w_suave"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/vazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nenhuma conta vence hoje"
            android:textColor="@color/w_ok"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/rodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
                <TextView
                    android:id="@+id/atualizado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Atualizado 11:42"
                    android:textColor="@color/w_suave"
                    android:textSize="9sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_w_atualizar" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
            <TextView
                android:id="@+id/estado_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Abra o VortexSmart"
                android:textColor="@color/w_forte"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estado_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="para carregar os números"
                android:textColor="@color/w_suave"
                android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
